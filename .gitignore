# ==============================================================================
# URCAD .gitignore
# GitHub audience: bioinformaticians, computational biologists, HR managers.
# Rule: version-control code and configs, never raw data or large binaries.
# ==============================================================================

# ---- Raw data (too large for GitHub, reproduced via download scripts) ---------
data/raw/
data/reference/

# ---- Processed / intermediate data (too large, reproduced by pipeline) --------
data/processed/

# ---- SRA temporary files -------------------------------------------------------
tmp/

# ---- Results (figures and tables are generated by scripts) --------------------
# Remove this block if you want to commit specific publication figures.
results/

# ---- R environment library (renv restores from renv.lock) --------------------
renv/library/
renv/staging/
renv/sandbox/

# ---- R session artifacts -------------------------------------------------------
.RData
.Rhistory
.Rapp.history
*.RDataTmp
*.RData

# ---- Large RDS / HDF5 / compressed data objects ------------------------------
*.rds
*.RDS
*.h5
*.h5seurat
*.loom

# ---- Log files (reproducible via re-running) -----------------------------------
logs/*.log
logs/*.out
logs/*.err

# ---- SLURM job output ----------------------------------------------------------
*.slurm.out
*.slurm.err
slurm-*.out
slurm-*.err

# ---- Python / Conda artifacts --------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.snakemake/
.snakemake_lock

# ---- OS / editor artifacts ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# ---- Jupyter notebooks (if used for exploration) ------------------------------
.ipynb_checkpoints/
*.ipynb

# ---- Docker build artifacts ---------------------------------------------------
.dockerignore
docker-compose.override.yml

# ==============================================================================
# DO commit (explicitly listed for clarity):
# ==============================================================================
# analysis/**/*.R          All R analysis scripts
# config/**                All config files (samples CSVs, YAML, accession lists)
# scripts/**               All shell scripts (download, pipeline, SLURM)
# workflow/**              Snakemake rules, envs
# Dockerfile               Container definition
# docker-compose.yml       Container orchestration
# renv.lock                Exact R package versions
# .Rprofile                renv activation
# README.md
# docs/
.Rproj.user
